# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored — never commit secrets.

# ── Claude API (chatbot) ────────────────────────────────────
# 향이 챗봇이 Claude API를 호출하려면 이 키가 필요해요.
# 키가 없으면 챗봇은 키워드 매칭 fallback 응답으로 동작합니다.
# 발급: https://console.anthropic.com/settings/keys
#
# 주의 — EXPO_PUBLIC_ 접두사는 빌드 시 번들에 인라인됩니다.
# 프로덕션에선 백엔드 프록시를 통해 호출하세요 (현재는 프로토타입 단계).
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Supabase (client-side 읽기) ─────────────────────────────
# 두 값이 모두 채워지면 `src/lib/api/*`가 Supabase에서 데이터를 읽어요.
# 비어 있으면 `src/lib/mockData.ts`를 그대로 반환합니다.
# anon key는 공개되어도 안전한 키예요 — RLS 정책이 데이터를 보호.
# Dashboard → Settings → API → URL / anon public key
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Supabase (seed script 전용, 서버 사이드) ────────────────
# 시드 스크립트(`npm run seed`)만 사용. RLS를 우회하므로 절대 클라이언트에 노출 금지.
# Dashboard → Settings → API → service_role secret
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Kakao 로그인 ────────────────────────────────────────────
# Developers 콘솔: https://developers.kakao.com
#  1. 애플리케이션 등록 → REST API 키 복사
#  2. 카카오 로그인 → '활성화 ON'
#  3. Redirect URI에 'matda://oauth/kakao' 등록
# 비어 있으면 LoginScreen은 mock 프로필로 통과시켜요(개발 편의).
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# ── Naver 로그인 ────────────────────────────────────────────
# Naver Developers: https://developers.naver.com/apps
#  1. 애플리케이션 등록 → 사용 API '네이버 로그인' 추가
#  2. Client ID / Secret 복사
#  3. Callback URL에 'matda://oauth/naver' 등록
# CLIENT_SECRET은 모바일 번들에 포함되니 프로덕션은 백엔드 프록시 권장.
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=
