  <View style={noteStyles.row}>
    <Text style={[noteStyles.label, { color }]}>{label}</Text>
    <View style={noteStyles.chips}>
      {notes.map((n) => (
        <View key={n} style={noteStyles.chip}>
          <Text style={noteStyles.chipText}>{n}</Text>
        </View>
      ))}
    </View>
  </View>
);
