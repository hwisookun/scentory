import React, { useState } from 'react';
import {
  View, Text, StyleSheet, ScrollView, TouchableOpacity,
  Modal, TextInput, KeyboardAvoidingView, TouchableWithoutFeedback, Keyboard, Platform,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { LinearGradient } from 'expo-linear-gradient';
import { Ionicons } from '@expo/vector-icons';
import { useNavigation, useRoute } from '@react-navigation/native';
import {
  COLORS, SPACING, BORDER_RADIUS, SHADOW, SCENT_COLORS, SCENT_TEXT_COLORS,
  FONT_SIZES, FONT_WEIGHTS, LINE_HEIGHTS, TOUCH_TARGET_MIN,
} from '../../constants/theme';
import { MOCK_PERFUMES, MOCK_REVIEWS } from '../../lib/mockData';
import { useAppStore } from '../../store/useAppStore';
import { Review } from '../../types';
import { BottleGlyph } from '../../components/common/PerfumeCard';

export const PerfumeDetailScreen: React.FC = () => {
  const navigation = useNavigation<any>();
  const route = useRoute<any>();
  const { perfumeId } = route.params;

  const perfume = MOCK_PERFUMES.find((p) => p.id === perfumeId);
  const { toggleWishlist, isWishlisted, addToCollection, isInCollection, incrementReviewCount } = useAppStore();

  const [localReviews, setLocalReviews] = useState<Review[]>(() =>
    MOCK_REVIEWS.filter((r) => r.perfume_id === perfumeId)
  );
  const [reviewModal, setReviewModal] = useState(false);
  const [newComment, setNewComment] = useState('');
  const [newRating, setNewRating] = useState(5);

  if (!perfume) return null;

  const wishlisted = isWishlisted(perfume.id);
  const inCollection = isInCollection(perfume.id);

  const similar = MOCK_PERFUMES.filter(
    (p) => p.id !== perfume.id && p.tags.some((t) => perfume.tags.includes(t))
  ).slice(0, 5);

  const submitReview = () => {
    if (!newComment.trim()) return;
    const r: Review = {
      id: Date.now().toString(),
      user_id: 'me',
      perfume_id: perfumeId,
      rating: newRating,
      comment: newComment,
      created_at: new Date().toISOString(),
      nickname: '나',
    };
    setLocalReviews((prev) => [r, ...prev]);
    incrementReviewCount();
    setNewComment('');
    setNewRating(5);
    setReviewModal(false);
  };

  return (
    <SafeAreaView style={styles.container}>
      <View style={styles.topBar}>
        <TouchableOpacity onPress={() => navigation.goBack()} style={styles.iconBtn}>
          <Ionicons name="arrow-back" size={22} color={COLORS.text} />
        </TouchableOpacity>
        <TouchableOpacity onPress={() => toggleWishlist(perfume)} style={styles.iconBtn}>
          <Ionicons
            name={wishlisted ? 'heart' : 'heart-outline'}
            size={22}
            color={wishlisted ? COLORS.accent : COLORS.text}
          />
        </TouchableOpacity>
      </View>

      <ScrollView showsVerticalScrollIndicator={false}>
        {/* Hero */}
        <LinearGradient
          colors={['#EAF6EF', '#D2EDDE', '#BEE4CD']}
          start={{ x: 0.1, y: 0 }}
          end={{ x: 0.9, y: 1 }}
          style={styles.hero}
        >
          <BottleGlyph perfume={perfume} size={100} />
        </LinearGradient>

        <View style={styles.content}>
          <Text style={styles.brandName}>{perfume.brand.name}</Text>
          <View style={styles.nameRow}>
            <Text style={styles.perfumeName}>{perfume.name}</Text>
            {perfume.brand.isNiche && (
              <View style={styles.nicheBadge}><Text style={styles.nicheBadgeText}>니치</Text></View>
            )}
          </View>

          <View style={styles.tagRow}>
            {perfume.tags.map((tag) => (
              <View key={tag} style={[styles.tag, { backgroundColor: SCENT_COLORS[tag] ?? COLORS.gray100 }]}>
                <Text style={[styles.tagText, { color: SCENT_TEXT_COLORS[tag] ?? COLORS.gray600 }]}>{tag}</Text>
              </View>
            ))}
            <View style={styles.concBadge}>
              <Text style={styles.concText}>{perfume.concentration}</Text>
            </View>
            {perfume.gender && (
              <View style={styles.genderBadge}>
                <Text style={styles.genderText}>{perfume.gender}</Text>
              </View>
            )}
          </View>

          <View style={styles.metaRow}>
            <View style={styles.metaItem}>
              <Ionicons name="star" size={16} color={COLORS.star} />
              <Text style={styles.metaValue}>{perfume.rating?.toFixed(1) ?? '-'}</Text>
              <Text style={styles.metaSub}>({perfume.review_count?.toLocaleString()})</Text>
            </View>
            <View style={styles.separator} />
            <Text style={styles.price}>{perfume.price_krw.toLocaleString()}원</Text>
          </View>

          {/* Notes */}
          <View style={styles.card}>
            <Text style={styles.cardTitle}>향 구성</Text>
            <NoteRow label="탑 노트" notes={perfume.top_notes} color={COLORS.primaryInk} />
            <NoteRow label="미들 노트" notes={perfume.middle_notes} color={COLORS.accent} />
            <NoteRow label="베이스 노트" notes={perfume.base_notes} color="#795548" />
          </View>

          {/* Actions */}
          <View style={styles.actionRow}>
            <TouchableOpacity
              style={[styles.actionBtn, styles.actionBtnOutline]}
              onPress={() => {
                if (!inCollection) addToCollection(perfume);
              }}
            >
              <Ionicons
                name={inCollection ? 'checkmark-circle' : 'add-circle-outline'}
                size={18}
                color={COLORS.primaryInk}
              />
              <Text style={styles.actionBtnOutlineText}>
                {inCollection ? '컬렉션 추가됨' : '내 컬렉션'}
              </Text>
            </TouchableOpacity>
            <TouchableOpacity
              style={[styles.actionBtn, styles.actionBtnPrimary]}
              onPress={() => toggleWishlist(perfume)}
            >
              <Ionicons
                name={wishlisted ? 'heart' : 'heart-outline'}
                size={18}
                color={COLORS.white}
              />
              <Text style={styles.actionBtnPrimaryText}>
                {wishlisted ? '찜 완료' : '찜하기'}
              </Text>
            </TouchableOpacity>
          </View>

          {/* Reviews */}
          <View style={styles.section}>
            <View style={styles.sectionHeader}>
              <Text style={styles.sectionTitle}>한줄평</Text>
              <TouchableOpacity style={styles.writeReviewBtn} onPress={() => setReviewModal(true)}>
                <Ionicons name="pencil" size={14} color={COLORS.primaryInk} />
                <Text style={styles.writeReviewText}>쓰러가기</Text>
              </TouchableOpacity>
            </View>
            {localReviews.length === 0 && (
              <Text style={styles.emptyText}>첫 번째 한줄평을 남겨보세요!</Text>
            )}
            {localReviews.map((r) => (
              <View key={r.id} style={styles.reviewCard}>
                <View style={styles.reviewHeader}>
                  <Text style={styles.reviewNickname}>{r.nickname}</Text>
                  <View style={styles.starRow}>
                    {Array.from({ length: 5 }).map((_, i) => (
                      <Ionicons key={i} name={i < r.rating ? 'star' : 'star-outline'} size={12} color={COLORS.star} />
                    ))}
                  </View>
                </View>
                <Text style={styles.reviewComment}>{r.comment}</Text>
              </View>
            ))}
          </View>

          {/* Similar */}
          {similar.length > 0 && (
            <View style={styles.section}>
              <Text style={styles.sectionTitle}>이런 향수도 있어요.</Text>
              <View style={styles.similarList}>
                {similar.map((p) => (
                  <TouchableOpacity
                    key={p.id}
                    style={styles.similarItem}
                    onPress={() => navigation.push('PerfumeDetail', { perfumeId: p.id })}
                    activeOpacity={0.85}
                  >
                    <LinearGradient
                      colors={['#F0F8F3', '#DCF1E2']}
                      style={styles.similarImg}
                    >
                      <BottleGlyph perfume={p} size={32} />
                    </LinearGradient>
                    <View style={styles.similarInfo}>
                      <Text style={styles.similarBrand}>{p.brand.name}</Text>
                      <Text style={styles.similarName} numberOfLines={1}>{p.name}</Text>
                      <Text style={styles.similarPrice}>{p.price_krw.toLocaleString()}원</Text>
                    </View>
                    <View style={styles.similarTags}>
                      {p.tags.slice(0, 2).map(t => (
                        <View key={t} style={[styles.similarTag, { backgroundColor: SCENT_COLORS[t] ?? COLORS.gray100 }]}>
                          <Text style={[styles.similarTagText, { color: SCENT_TEXT_COLORS[t] ?? COLORS.gray600 }]}>{t}</Text>
                        </View>
                      ))}
                    </View>
                    <Ionicons name="chevron-forward" size={16} color={COLORS.gray400} />
                  </TouchableOpacity>
                ))}
              </View>
            </View>
          )}
        </View>
      </ScrollView>

      {/* Review Modal */}
      <Modal visible={reviewModal} animationType="slide" transparent statusBarTranslucent>
        <KeyboardAvoidingView
          behavior={Platform.OS === 'ios' ? 'padding' : 'height'}
          style={{ flex: 1 }}
        >
          <TouchableWithoutFeedback onPress={Keyboard.dismiss}>
            <View style={styles.modalOverlay}>
              <TouchableWithoutFeedback>
                <View style={styles.modalCard}>
                  <View style={styles.modalHeader}>
                    <Text style={styles.modalTitle}>한줄평 쓰기</Text>
                    <TouchableOpacity onPress={() => { Keyboard.dismiss(); setReviewModal(false); }}>
                      <Ionicons name="close" size={22} color={COLORS.gray600} />
                    </TouchableOpacity>
                  </View>
                  <View style={styles.starSelect}>
                    {Array.from({ length: 5 }).map((_, i) => (
                      <TouchableOpacity key={i} onPress={() => setNewRating(i + 1)}>
                        <Ionicons name={i < newRating ? 'star' : 'star-outline'} size={28} color={COLORS.star} />
                      </TouchableOpacity>
                    ))}
                  </View>
                  <TextInput
                    style={styles.commentInput}
                    placeholder="솔직한 한줄평을 남겨주세요"
                    placeholderTextColor={COLORS.textSecondary}
                    multiline
                    value={newComment}
                    onChangeText={setNewComment}
                    autoFocus
                  />
                  <TouchableOpacity style={styles.submitBtn} onPress={submitReview}>
                    <Text style={styles.submitBtnText}>등록하기</Text>
                  </TouchableOpacity>
                </View>
              </TouchableWithoutFeedback>
            </View>
          </TouchableWithoutFeedback>
        </KeyboardAvoidingView>
      </Modal>
    </SafeAreaView>
  );
};

